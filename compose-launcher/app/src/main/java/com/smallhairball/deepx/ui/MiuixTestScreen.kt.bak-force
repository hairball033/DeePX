/** A single account row rendered as a Miuix card. */
@Composable
private fun AccountRowCard(
    account: AccountItem,
    multiSelectMode: Boolean,
    selected: Boolean,
    onClick: () -> Unit,
    onLongClick: () -> Unit,
) {
    val colorScheme = MiuixTheme.colorScheme
    Box(
        modifier = Modifier
            .fillMaxWidth()
            .combinedClickable(onClick = onClick, onLongClick = onLongClick),
    ) {
        Card(modifier = Modifier.fillMaxWidth()) {
            Row(
                modifier = Modifier.fillMaxWidth().padding(16.dp),
                verticalAlignment = Alignment.CenterVertically,
            ) {
                Column(
                    modifier = Modifier.weight(1f),
                    verticalArrangement = Arrangement.spacedBy(2.dp),
                ) {
                    Text(account.label, style = MiuixTheme.textStyles.title4)
                    val sub = runCatching {
                        com.smallhairball.deepx.AccountsBridge.subtitle(account.provider)
                    }.getOrDefault("")
                    if (sub.isNotBlank()) {
                        Text(
                            text = sub,
                            style = MiuixTheme.textStyles.body2,
                            color = colorScheme.onSurfaceVariantSummary,
                        )
                    }
                }
                when {
                    multiSelectMode && selected -> Icon(
                        imageVector = Icons.Rounded.CheckCircleOutline,
                        contentDescription = "已选",
                        tint = colorScheme.primary,
                        modifier = Modifier.size(20.dp),
                    )
                    account.current -> Text(
                        text = "当前",
                        style = MiuixTheme.textStyles.footnote1,
                        color = colorScheme.primary,
                    )
                    else -> Icon(
                        imageVector = Icons.AutoMirrored.Rounded.KeyboardArrowRight,
                        contentDescription = null,
                        tint = colorScheme.onSurfaceVariantSummary,
                        modifier = Modifier.size(20.dp),
                    )
                }
            }
        }
    }
}

/**
 * Announcement dialog rendered with Miuix, shown by {@code DeePXHostLauncher.showAnnouncementDialog}.
 *
 * <p>Deliberately not a [ConfirmDialog]: there, dismissing by tapping outside is routed to the
 * negative action, which would silently and permanently mute the announcement. Here an outside tap
 * (or back) only closes the dialog, and the permanent "不再提醒" record is written exclusively by
 * the negative button.
 */
@Composable
fun AnnouncementDialog(
    title: String,
    body: String,
    onDismissDialog: () -> Unit,
    onMute: () -> Unit,
) {
    var show by remember { mutableStateOf(true) }
    var mute by remember { mutableStateOf(false) }

    OverlayDialog(
        title = title,
        show = show,
        onDismissRequest = { show = false },
        onDismissFinished = {
            onDismissDialog()
            if (mute) onMute()
        },
    ) {
        Column(
            modifier = Modifier.fillMaxWidth(),
            verticalArrangement = Arrangement.spacedBy(16.dp),
        ) {
            androidx.compose.foundation.text.selection.SelectionContainer {
                Text(
                    text = body,
                    textAlign = androidx.compose.ui.text.style.TextAlign.Start,
                    modifier = Modifier
                        .fillMaxWidth()
                        .heightIn(max = 360.dp)
                        .verticalScroll(rememberScrollState()),
                    style = MiuixTheme.textStyles.body2,
                    color = MiuixTheme.colorScheme.onSurfaceVariantSummary,
                )
            }
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(12.dp),
            ) {
                TextButton(
                    text = "不再提醒",
                    onClick = {
                        mute = true
                        show = false
                    },
                    modifier = Modifier.weight(1f),
                )
                Spacer(Modifier.width(8.dp))
                TextButton(
                    text = "确定",
                    onClick = { show = false },
                    modifier = Modifier.weight(1f),
                    colors = ButtonDefaults.textButtonColorsPrimary(),
                )
            }
        }
    }
}

/**
 * Generic Miuix confirm dialog used by the injected process. Shown through
 * {@code DeePXHostLauncher.showConfirmDialog} whenever a Java-side confirmation is requested.
 *
 * [show] is kept internally so the close animation can play: tapping a button flips it to false,
 * and only once the dialog has finished animating out do we dismiss the host Dialog and run the
 * side effect.
 */
@Composable
fun ConfirmDialog(
    title: String,
    message: String,
    negativeLabel: String?,
    positiveLabel: String,
    verticalButtons: Boolean,
    onDismissDialog: () -> Unit,
    onNegative: () -> Unit,
    onPositive: () -> Unit,
) {
    var show by remember { mutableStateOf(true) }
    var pending by remember { mutableStateOf<Runnable?>(null) }

    OverlayDialog(
        title = title,
        show = show,
        onDismissRequest = {
            if (show) {
                pending = Runnable { onNegative() }
                show = false
            }
        },
        onDismissFinished = {
            onDismissDialog()
            val action = pending
            pending = null
            action?.run()
        },
    ) {
        Text(
            text = message,
            modifier = Modifier
                .fillMaxWidth()
                .heightIn(max = 360.dp)
                .verticalScroll(rememberScrollState()),
            style = MiuixTheme.textStyles.body2,
            color = MiuixTheme.colorScheme.onSurfaceVariantSummary,
        )
        Spacer(Modifier.height(12.dp))
        if (verticalButtons) {
            Column(
                modifier = Modifier.fillMaxWidth(),
                verticalArrangement = Arrangement.spacedBy(8.dp),
            ) {
                if (negativeLabel != null) {
                    TextButton(
                        text = negativeLabel,
                        onClick = {
                            pending = Runnable { onNegative() }
                            show = false
                        },
                        modifier = Modifier.fillMaxWidth(),
                    )
                }
                TextButton(
                    text = positiveLabel,
                    onClick = {
                        pending = Runnable { onPositive() }
                        show = false
                    },
                    modifier = Modifier.fillMaxWidth(),
                    colors = ButtonDefaults.textButtonColorsPrimary(),
                )
            }
        } else {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
            ) {
                TextButton(
                    text = negativeLabel ?: "取消",
                    onClick = {
                        pending = Runnable { onNegative() }
                        show = false
                    },
                    modifier = Modifier.weight(1f),
                )
                Spacer(Modifier.width(20.dp))
                TextButton(
                    text = positiveLabel,
                    onClick = {
                        pending = Runnable { onPositive() }
                        show = false
                    },
                    modifier = Modifier.weight(1f),
                    colors = ButtonDefaults.textButtonColorsPrimary(),
                )
            }
        }
    }
}

/**
 * "Add account" dialog rendered with Miuix. Offers password login and native login, mirroring the
 * original two-branch dialog.
 */
/**
 * "执行" (task console) page rendered with Miuix. The job runs on the Java side
 * ({@code TaskConsoleBridge}) and this page polls its snapshot, so the streamed lines, the final
 * result and the save-log action stay in sync without a callback crossing into the View-only
 * module source tree. Reproduces the legacy console: monospace auto-scrolling log, a save action in
 * the top bar, a close button gated on completion and the result announced by its own dialog.
 *
 * <p>The hosting Dialog is created and shown by the Java caller, which also applies the shared
 * edge-to-edge system-bar treatment and the Activity push/pop window animation.
 */
@Composable
fun TaskConsoleScreen(
    fallbackTitle: String,
    fallbackHint: String,
    onClose: () -> Unit,
) {
    val colorScheme = MiuixTheme.colorScheme
    val context = androidx.compose.ui.platform.LocalContext.current
    val activity = context as? android.app.Activity
    val scrollBehavior = MiuixScrollBehavior()
    val logScroll = rememberScrollState()

    var snapshot by remember {
        mutableStateOf(
            runCatching { com.smallhairball.deepx.TaskConsoleBridge.snapshot() }.getOrNull()
        )
    }
    // The result is announced by its own dialog (like the legacy console did); this only tracks
    // whether the user already acknowledged it.
    var resultDismissed by remember { mutableStateOf(false) }

    // The console streams lines instead of reporting once, so poll while the job is running. The
    // session is started right after this dialog is attached, so keep polling briefly even when the
    // first snapshot still looks idle, and stop as soon as the job reports completion.
    LaunchedEffect(Unit) {
        var idleTicks = 0
        while (true) {
            val next = runCatching { com.smallhairball.deepx.TaskConsoleBridge.snapshot() }
                .getOrNull()
            snapshot = next
            if (next?.complete == true) break
            if (next?.running == true) {
                idleTicks = 0
            } else {
                idleTicks++
                if (idleTicks > 60) break
            }
            kotlinx.coroutines.delay(120L)
        }
    }

    // Keep the tail in view, like the legacy console's auto-scroll.
    LaunchedEffect(snapshot?.log) {
        logScroll.animateScrollTo(logScroll.maxValue)
    }

    val title = snapshot?.title?.takeIf { it.isNotBlank() } ?: fallbackTitle
    val done = snapshot?.complete == true
    val failed = snapshot?.failed == true
    val logText = snapshot?.log.orEmpty().ifBlank { fallbackHint }

    Scaffold(
        topBar = {
            TopAppBar(
                title = title.ifBlank { "执行" },
                navigationIcon = {
                    IconButton(onClick = { if (done) onClose() }) {
                        Icon(
                            imageVector = Icons.AutoMirrored.Rounded.ArrowBack,
                            contentDescription = "返回",
                            tint = colorScheme.onBackground,
                            modifier = Modifier.size(20.dp),
                        )
                    }
                },
                actions = {
                    TextButton(
                        text = "保存日志",
                        onClick = {
                            if (activity != null) {
                                runCatching {
                                    com.smallhairball.deepx.TaskConsoleBridge.saveLog(activity)
                                }
                            }
                            snapshot = runCatching {
                                com.smallhairball.deepx.TaskConsoleBridge.snapshot()
                            }.getOrNull()
                        },
                    )
                },
                scrollBehavior = scrollBehavior,
            )
        },
    ) { innerPadding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(
                    start = 12.dp,
                    end = 12.dp,
                    top = innerPadding.calculateTopPadding() + 8.dp,
                    bottom = innerPadding.calculateBottomPadding() + 12.dp,
                ),
        ) {
            if (!done) {
                top.yukonga.miuix.kmp.basic.InfiniteProgressIndicator(
                    color = colorScheme.primary,
                    modifier = Modifier.fillMaxWidth(),
                )
                Spacer(Modifier.height(10.dp))
            }
            Card(modifier = Modifier.fillMaxWidth().weight(1f)) {
                androidx.compose.foundation.text.selection.SelectionContainer {
                    Column(
                        modifier = Modifier
                            .fillMaxSize()
                            .verticalScroll(logScroll)
                            .padding(12.dp),
                    ) {
                        Text(
                            text = logText,
                            style = MiuixTheme.textStyles.footnote1.copy(
                                fontFamily = androidx.compose.ui.text.font.FontFamily.Monospace,
                                fontSize = 11.sp,
                                lineHeight = 16.sp,
                            ),
                            color = colorScheme.onSurface,
                        )
                    }
                }
            }
            // Mirror the legacy page: the result arrives as its own dialog instead of inline.
            if (done && snapshot?.hasResult() == true) {
                OverlayDialog(
                    title = if (failed) "执行失败" else title.ifBlank { "执行结果" },
                    show = !resultDismissed,
                    onDismissRequest = { resultDismissed = true },
                ) {
                    androidx.compose.foundation.text.selection.SelectionContainer {
                        Text(
                            text = snapshot?.result.orEmpty(),
                            modifier = Modifier
                                .fillMaxWidth()
                                .heightIn(max = 320.dp)
                                .verticalScroll(rememberScrollState())
                                .padding(bottom = 12.dp),
                            style = MiuixTheme.textStyles.body2,
                            color = colorScheme.onSurfaceVariantSummary,
                        )
                    }
                    TextButton(
                        text = "确定",
                        onClick = { resultDismissed = true },
                        modifier = Modifier.fillMaxWidth(),
                        colors = ButtonDefaults.textButtonColorsPrimary(),
                    )
                }
            }
            if (done) {
                Spacer(Modifier.height(10.dp))
                TextButton(
                    text = "关闭",
                    onClick = onClose,
                    modifier = Modifier.fillMaxWidth(),
                    colors = ButtonDefaults.textButtonColorsPrimary(),
                )
            }
        }
    }
}

/**
 * "Processing" dialog content rendered with Miuix: a title, an indeterminate progress indicator and
 * a stage label that cycles every [stageIntervalMs]. Shown by
 * {@code DeePXHostLauncher.showProgressDialog}.
 */
@Composable
fun ProgressDialogContent(
    title: String,
    stages: Array<String>,
    stageIntervalMs: Long,
) {
    var index by remember { mutableStateOf(0) }
    LaunchedEffect(Unit) {
        if (stages.size > 1) {
            while (true) {
                kotlinx.coroutines.delay(stageIntervalMs)
                index = (index + 1) % stages.size
            }
        }
    }
    OverlayDialog(
        title = title,
        show = true,
        onDismissRequest = {},
    ) {
        Text(
            text = stages.getOrElse(index) { "" },
            style = MiuixTheme.textStyles.body2,
            color = MiuixTheme.colorScheme.onSurfaceVariantSummary,
        )
        Spacer(Modifier.height(14.dp))
        top.yukonga.miuix.kmp.basic.InfiniteProgressIndicator(
            color = MiuixTheme.colorScheme.primary,
            modifier = Modifier.fillMaxWidth(),
        )
    }
}

@Composable
private fun AddAccountDialog(
    show: Boolean,
    onClose: () -> Unit,
    onPasswordLogin: () -> Unit,
    onNativeLogin: () -> Unit,
) {
    val colorScheme = MiuixTheme.colorScheme
    OverlayDialog(
        title = "添加账号",
        show = show,
        onDismissRequest = onClose,
    ) {
        Text(
            text = "当前账号不会被切换。可直接验证邮箱/手机号密码并加入候选列表，或使用原生登录页添加其他方式。",
            style = MiuixTheme.textStyles.body2,
            color = colorScheme.onSurfaceVariantSummary,
        )
        Spacer(Modifier.height(12.dp))
        TextButton(
            text = "密码登录",
            onClick = onPasswordLogin,
            modifier = Modifier.fillMaxWidth(),
            colors = ButtonDefaults.textButtonColorsPrimary(),
        )
        Spacer(Modifier.height(8.dp))
        TextButton(
            text = "原生登录页",
            onClick = onNativeLogin,
            modifier = Modifier.fillMaxWidth(),
        )
        Spacer(Modifier.height(8.dp))
        TextButton(
            text = "取消",
            onClick = onClose,
            modifier = Modifier.fillMaxWidth(),
        )
    }
}

/**
 * Password-login dialog rendered with Miuix. Identity/password are submitted through
 * {@code AccountsBridge.passwordAdd}; the result is reported back for status display.
 */
@Composable
private fun PasswordLoginDialog(
    show: Boolean,
    onClose: () -> Unit,
    onSubmit: (String, String, (Boolean, String) -> Unit) -> Unit,
) {
    val colorScheme = MiuixTheme.colorScheme
    val identityState = androidx.compose.foundation.text.input.rememberTextFieldState("")
    val passwordState = androidx.compose.foundation.text.input.rememberTextFieldState("")
    var status by remember { mutableStateOf("") }
    var busy by remember { mutableStateOf(false) }

    OverlayDialog(
        title = "密码登录",
        show = show,
        onDismissRequest = onClose,
    ) {
        Text(
            text = "认证成功后只加入账号列表，不切换当前账号。密码不会保存。",
            style = MiuixTheme.textStyles.footnote1,
            color = colorScheme.onSurfaceVariantSummary,
        )
        Spacer(Modifier.height(10.dp))
        top.yukonga.miuix.kmp.basic.TextField(
            state = identityState,
            label = "邮箱或手机号",
            modifier = Modifier.fillMaxWidth(),
        )
        Spacer(Modifier.height(8.dp))
        top.yukonga.miuix.kmp.basic.TextField(
            state = passwordState,
            label = "密码",
            modifier = Modifier.fillMaxWidth(),
        )
        if (status.isNotBlank()) {
            Spacer(Modifier.height(8.dp))
            Text(
                text = status,
                style = MiuixTheme.textStyles.footnote1,
                color = colorScheme.primary,
            )
        }
        Spacer(Modifier.height(12.dp))
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceBetween,
        ) {
            TextButton(
                text = "取消",
                onClick = onClose,
                modifier = Modifier.weight(1f),
            )
            Spacer(Modifier.width(20.dp))
            TextButton(
                text = if (busy) "验证中…" else "验证并添加",
                onClick = {
                    val identity = identityState.text.toString().trim()
                    val password = passwordState.text.toString()
                    if (identity.isEmpty() || password.isEmpty()) return@TextButton
                    busy = true
                    status = "正在通过 DeepSeek 原生链路验证…"
                    onSubmit(identity, password) { success, message ->
                        busy = false
                        status = message
                    }
                },
                modifier = Modifier.weight(1f),
                colors = ButtonDefaults.textButtonColorsPrimary(),
            )
        }
    }
}

@Composable
private fun ActivationCard(active: Boolean) {
    val colorScheme = MiuixTheme.colorScheme
    val container = if (active) colorScheme.tertiaryContainer else colorScheme.errorContainer
    val onContainer = if (active) colorScheme.onTertiaryContainer else colorScheme.onErrorContainer
    val accent = if (active) colorScheme.primary else colorScheme.error

    Card(
        modifier = Modifier.fillMaxWidth(),
        pressFeedbackType = PressFeedbackType.Tilt,
        colors = CardDefaults.defaultColors(
            color = container,
            contentColor = onContainer,
        ),
    ) {
        Box {
            Box(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(27.dp, 31.dp),
                contentAlignment = Alignment.BottomEnd,
            ) {
                Icon(
                    imageVector = if (active) {
                        Icons.Rounded.CheckCircleOutline
                    } else {
                        Icons.Rounded.ErrorOutline
                    },
                    contentDescription = null,
                    tint = accent.copy(alpha = 0.35f),
                    modifier = Modifier.size(96.dp),
                )
            }
            Column(modifier = Modifier.fillMaxWidth().padding(16.dp, 18.dp)) {
                Text(
                    text = if (active) "模块已激活" else "模块未激活",
                    fontSize = 20.sp,
                    color = onContainer,
                )
                Spacer(Modifier.height(6.dp))
                Text(
                    text = if (active) {
                        "DeePX 已在 DeepSeek 进程内注入并运行"
                    } else {
                        "未检测到注入，请在 LSPosed 中启用模块并勾选 DeepSeek"
                    },
                    fontSize = 13.sp,
                    color = onContainer.copy(alpha = 0.75f),
                )
            }
        }
    }
}

/** Card with an icon header and a stack of label/value rows. */
@Composable
private fun InfoPanel(icon: ImageVector, rows: List<Pair<String, String>>) {
    val colorScheme = MiuixTheme.colorScheme
    Card(modifier = Modifier.fillMaxWidth()) {
        Column(modifier = Modifier.fillMaxWidth().padding(16.dp)) {
            Icon(
                imageVector = icon,
                contentDescription = null,
                tint = colorScheme.primary,
                modifier = Modifier.size(24.dp),
            )
            Spacer(Modifier.height(16.dp))
            rows.forEachIndexed { index, row ->
                Column(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(bottom = if (index == rows.lastIndex) 0.dp else 18.dp),
                ) {
                    Text(
                        text = row.first,
                        style = MiuixTheme.textStyles.body2,
                        color = colorScheme.onSurfaceVariantSummary,
                    )
                    Spacer(Modifier.height(2.dp))
                    Text(
                        text = row.second.ifEmpty { "—" },
                        style = MiuixTheme.textStyles.body1,
                        color = colorScheme.onSurface,
                    )
                }
            }
        }
    }
}