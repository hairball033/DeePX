/** Slider tuning dialog rendered with Miuix (whale rotation / text-wave speed). */
@Composable
private fun SpeedDialog(
    show: Boolean,
    title: String,
    min: Float,
    max: Float,
    lowLabel: String,
    highLabel: String,
    initial: Float,
    onSave: (Float) -> Unit,
    onClose: () -> Unit,
) {
    val colorScheme = MiuixTheme.colorScheme
    var value by remember { mutableStateOf(initial.coerceIn(min, max)) }

    OverlayDialog(
        title = title,
        show = show,
        onDismissRequest = onClose,
    ) {
        Text(
            text = String.format(java.util.Locale.US, "%.1f×", value),
            modifier = Modifier.fillMaxWidth(),
            style = MiuixTheme.textStyles.title2,
            color = colorScheme.onSurface,
            textAlign = androidx.compose.ui.text.style.TextAlign.Center,
        )
        Spacer(Modifier.height(8.dp))
        top.yukonga.miuix.kmp.basic.Slider(
            value = value,
            onValueChange = { value = it },
            valueRange = min..max,
            modifier = Modifier.fillMaxWidth(),
        )
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceBetween,
        ) {
            Text(
                text = lowLabel,
                style = MiuixTheme.textStyles.footnote1,
                color = colorScheme.onSurfaceVariantSummary,
            )
            Text(
                text = highLabel,
                style = MiuixTheme.textStyles.footnote1,
                color = colorScheme.onSurfaceVariantSummary,
            )
        }
        Spacer(Modifier.height(12.dp))
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceBetween,
        ) {
            TextButton(
                text = "取消",
                onClick = onClose,
                modifier = Modifier.weight(1f),
            )
            Spacer(Modifier.width(20.dp))
            TextButton(
                text = "保存",
                onClick = {
                    runCatching { onSave(value) }
                    onClose()
                },
                modifier = Modifier.weight(1f),
                colors = ButtonDefaults.textButtonColorsPrimary(),
            )
        }
    }
}

/** Theme-colour dialog rendered with Miuix: enable switch plus two colour pickers. */
